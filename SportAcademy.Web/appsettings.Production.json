{
  // Windows-integrated auth (Trusted_Connection) cannot work from a Linux container - there is
  // no domain identity to present. Real value is SQL auth against the compose "db" service,
  // supplied at deploy time via the ConnectionStrings__DefaultConnection environment variable
  // (see deploy/.env.example) - never commit a real password here.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  // The CONSOLE app's own origin, not the API's and not the marketing site's: every link in an
  // outgoing email is built from this (invitations land on /t/{slug}/invite/{token}, resets on
  // /reset-password), and those are React routes served by the console, which now lives on its
  // own subdomain separate from the marketing site at the apex domain.
  "AppSettings": {
    "BaseUrl": "https://app.auraacademys.com"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/sportacademy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "shared": true
        }
      }
    ]
  },
  "Storage": {
    "UploadsPath": "/app/uploads",
    "LogsPath": "/app/logs"
  },
  // Origins allowed to call this API from a browser, matched literally on scheme+host - the
  // console's own subdomain (app.auraacademys.com, authenticated browser traffic) plus the
  // marketing apex/www (anonymous public endpoints only: /api/public/*). In production, Caddy
  // actually proxies /api on the same host each app is served from, so these calls are normally
  // same-origin and never hit CORS at all - this list exists as the correct fallback for any
  // client that does call the API cross-origin, and to fail loudly rather than silently if that
  // ever happens.
  "Cors": {
    "AllowedOrigins": [
      "https://app.auraacademys.com",
      "https://auraacademys.com",
      "https://www.auraacademys.com"
    ]
  },
  "SignalR": {
    "RedisConnection": ""
  }
}