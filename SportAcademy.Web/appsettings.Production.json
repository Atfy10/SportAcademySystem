{
  // Windows-integrated auth (Trusted_Connection) cannot work from a Linux container - there is
  // no domain identity to present. Real value is SQL auth against the compose "db" service,
  // supplied at deploy time via the ConnectionStrings__DefaultConnection environment variable
  // (see deploy/.env.example) - never commit a real password here.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  // The FRONTEND origin, not the API's: every link in an outgoing email is built from this
  // (invitations land on /t/{slug}/invite/{token}, resets on /reset-password), and those are
  // React routes the recipient opens in a browser. If the API is later hosted on its own
  // subdomain, this still points at wherever the app is served from.
  "AppSettings": {
    "BaseUrl": "https://auraacademys.com"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/sportacademy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "shared": true
        }
      }
    ]
  },
  "Storage": {
    "UploadsPath": "/app/uploads",
    "LogsPath": "/app/logs"
  },
  // Origins allowed to call this API from a browser - again the frontend's, and it must match
  // scheme and host exactly (https://auraacademys.com and https://www.auraacademys.com are two
  // different origins to CORS). Add each host the app is actually served from.
  // Both hosts are served, and CORS matches origins literally - www and the apex are two
  // different origins to a browser, so both have to be listed even though they serve the same
  // app. BaseUrl above stays on the apex: email links should use one canonical host.
  "Cors": {
    "AllowedOrigins": [
      "https://auraacademys.com",
      "https://www.auraacademys.com"
    ]
  },
  // Demo data only. Leave false in production: a fresh database would otherwise be seeded with
  // the fictional "Salmiya Academy" tenant and its trainees, payments and invoices. It also
  // decides the email sender - true swaps the real SendGrid sender for the file-logging
  // decorator that writes invitation links to dev-invitation-links.txt instead of sending them.
  "Seeding": {
    "Enabled": false
  },
  "SignalR": {
    "RedisConnection": ""
  }
}