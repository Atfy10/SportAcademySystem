{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sportacademy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "SportAcademy"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    //"DefaultConnection": "Server=.;Database=TestSportAcademyDb;Trusted_Connection=True;TrustServerCertificate=True;"
    "DefaultConnection": "Server=.;Database=TestMTSportAcademyDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  // Jwt:Key, OpenRouterSettings:ApiKey and Email:SendGridApiKey are intentionally blank here.
  // Set them via `dotnet user-secrets set "Jwt:Key" "..."` (per project, in SportAcademy.Web)
  // for local dev, or via environment variables (Jwt__Key, OpenRouterSettings__ApiKey,
  // Email__SendGridApiKey) in any deployed environment. Never commit real values to this file.
  "Jwt": {
    "Key": "",
    "Issuer": "SportAcademy",
    "Audience": "MyAppUsers",
    "ExpireMinutes": 60
  },

  "OpenRouterSettings": {
    "ApiKey": "",
    "Model": "arcee-ai/trinity-large-preview:free"
  },

  "Email": {
    "Provider": "SendGrid",
    "SendGridApiKey": "",
    "FromEmail": "abdulrahmannalatfy@gmail.com", //"noreply@auraacademy.com",
    "FromName": "AURA Academy"
  },

  "AppSettings": {
    "BaseUrl": "http://localhost:8080"
  },

  "TenantArchival": {
    "RetentionDays": 30
  }
}
