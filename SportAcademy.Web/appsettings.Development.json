{
  // SendGridApiKey intentionally blank - set via dotnet user-secrets or Email__SendGridApiKey env var.
  // Overrides the base appsettings.json - whatever is set here wins in Development, so a
  // provider switch has to be made here too, not just there.
  // FromEmail is Resend's sandbox sender, which works with no domain verification but only
  // delivers to the address that owns the Resend account. Change it to
  // noreply@auraacademys.com (the production value) once that domain is verified.
  "Email": {
    "Provider": "Resend",
    "FromEmail": "onboarding@resend.dev",
    "FromName": "AURA Academy"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sportacademy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
