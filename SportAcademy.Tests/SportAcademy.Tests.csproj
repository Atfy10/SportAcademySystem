<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Pins System.IdentityModel.Tokens.Jwt to match the Microsoft.IdentityModel.Tokens 8.14.0
         resolved transitively elsewhere in the graph. Without this, the test host resolves
         System.IdentityModel.Tokens.Jwt to 8.0.1, which throws TypeLoadException from
         JwtSecurityTokenHandler.CreateToken against the newer Microsoft.IdentityModel.Tokens.
         The real SportAcademy.Web app is unaffected (its ASP.NET Core host resolves both
         consistently), so this only needs fixing here in the test project. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportAcademy.Application\SportAcademy.Application.csproj" />
    <ProjectReference Include="..\SportAcademy.Domain\SportAcademy.Domain.csproj" />
    <ProjectReference Include="..\SportAcademy.Infrastructure\SportAcademy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
