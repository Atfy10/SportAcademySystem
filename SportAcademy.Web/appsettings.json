{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sportacademy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "SportAcademy"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=TestMTSportAcademyDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  // Jwt:Key and Email:SendGridApiKey are intentionally blank here. Set them via
  // `dotnet user-secrets set "Jwt:Key" "..."` (per project, in SportAcademy.Web) for local dev,
  // or via environment variables (Jwt__Key, Email__SendGridApiKey) in any deployed environment.
  // Never commit real values to this file.
  "Jwt": {
    "Key": "",
    "Issuer": "SportAcademy",
    "Audience": "MyAppUsers",
    "ExpireMinutes": 60
  },

  // Provider selects the sender: "Resend" or "SendGrid". Only the matching key needs a value,
  // and like Jwt:Key it is never set here - use `dotnet user-secrets set "Email:ResendApiKey"
  // "..."` locally, or the Email__ResendApiKey environment variable in a deployed environment.
  // FromEmail must be on a domain verified with whichever provider is active.
  "Email": {
    "Provider": "Resend",
    "ResendApiKey": "",
    "SendGridApiKey": "",
    "FromEmail": "noreply@auraacademys.com",
    "FromName": "AURA Academy"
  },

  "AppSettings": {
    "BaseUrl": "http://localhost:8080"
  },

  "TenantArchival": {
    "RetentionDays": 30
  }
}
