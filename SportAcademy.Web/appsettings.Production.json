{
  "ConnectionStrings": {
    "DefaultConnection": "Server=ATFY-PC\\SQLEXPRESS;Database=TestMTSportAcademyDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AppSettings": {
    "BaseUrl": "http://localhost:44306"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "..\\logs\\sportacademy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "shared": true
        }
      }
    ]
  },
  "Storage": {
    "UploadsPath": "..\\Uploads",
    "LogsPath": "..\\Logs"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:44306"
    ]
  },
  // Demo data only. Leave false in production: a fresh database would otherwise be seeded with
  // the fictional "Salmiya Academy" tenant and its trainees, payments and invoices. It also
  // decides the email sender - true swaps the real SendGrid sender for the file-logging
  // decorator that writes invitation links to dev-invitation-links.txt instead of sending them.
  "Seeding": {
    "Enabled": false
  },
  "SignalR": {
    "RedisConnection": ""
  }
}